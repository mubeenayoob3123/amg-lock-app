<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textColor="@color/navy"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_subtitle"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <!-- F-9 (Wave 0.5): persistent "not protected" banner, shown whenever
             the app is NOT Device Owner (checked on every launch). Hidden
             once Device Owner is restored. -->
        <TextView
            android:id="@+id/tvNotProtected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/red"
            android:padding="14dp"
            android:text="@string/not_protected_banner"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDeviceOwner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/white"
            android:padding="14dp"
            android:text="@string/device_owner_no"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/white"
            android:padding="14dp"
            android:text="@string/status_not_registered"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 3.10: success state after registration (green check, account,
             next due, last check-in). Hidden until registered. -->
        <TextView
            android:id="@+id/tvRegisteredSuccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/emerald"
            android:padding="14dp"
            android:text=""
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- F-19: warning banner — opens the full warning screen. -->
        <LinearLayout
            android:id="@+id/llWarningBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/amber"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/warning_banner_text"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnViewWarning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/navy"
                android:text="@string/warning_banner_button" />
        </LinearLayout>

        <!-- F-33 / A-M10: battery optimisation exemption card. -->
        <LinearLayout
            android:id="@+id/llBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_title"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/battery_body"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnBatteryExempt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/navy"
                android:text="@string/battery_button" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/white"
            android:padding="14dp"
            android:text=""
            android:textColor="@color/text"
            android:textSize="15sp" />

        <!-- 3.10: Setup card — pairing code FIRST, server URL second
             (prefilled with the live server; no hardcoded android:text
             any more — single source of truth is LockStateStore, A-n10).
             Hidden after registration (F-12). -->
        <LinearLayout
            android:id="@+id/llSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etPairingCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@color/white"
                android:hint="@string/pairing_code_label"
                android:inputType="textCapCharacters"
                android:maxLength="8"
                android:padding="14dp" />

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/white"
                android:hint="@string/server_url_label"
                android:inputType="textUri"
                android:padding="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/server_url_note"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <!-- QR pairing scan (A-M13 / Wave 5.6): dashboard ka pairing
                 QR scan karein — server URL + pairing code khud bhar
                 jate hain, phir Register dabayein. -->
            <Button
                android:id="@+id/btnQrScan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/navy"
                android:text="@string/qr_scan_button" />

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/emerald"
                android:text="@string/register_button" />

            <!-- Persistent plain-language error (F-11) — not just a toast. -->
            <TextView
                android:id="@+id/tvSetupError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/white"
                android:padding="14dp"
                android:text=""
                android:textColor="@color/red"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 3.10: registered state — masked code, reset only via a
             deliberate confirmed action. -->
        <LinearLayout
            android:id="@+id/llRegistered"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvRegisteredInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnResetRegistration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/red"
                android:text="@string/reset_button" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCheckNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/navy"
            android:text="@string/check_now_button" />

    </LinearLayout>
</ScrollView>
