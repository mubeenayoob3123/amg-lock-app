<?xml version="1.0" encoding="utf-8"?>
<!--
  Warning screen (F-19 / 3.4) — qist late hai, grace chal raha hai,
  phone abhi poora chalta hai. Amber header, plain Roman Urdu.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="⚠️"
            android:textSize="56sp" />

        <TextView
            android:id="@+id/tvWarnTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/warning_title"
            android:textColor="@color/navy"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWarnDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/white"
            android:padding="16dp"
            android:text=""
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvWarnGuidance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/white"
            android:padding="16dp"
            android:text=""
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvWarnShop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnWarnCallShop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/navy"
            android:text="@string/call_shop_button" />

        <Button
            android:id="@+id/btnWarnCheckNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/emerald"
            android:text="@string/check_now_button" />

        <TextView
            android:id="@+id/tvWarnStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnWarnDismiss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/muted"
            android:text="@string/warning_dismiss" />

    </LinearLayout>
</ScrollView>
