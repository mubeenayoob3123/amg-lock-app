<?xml version="1.0" encoding="utf-8"?>
<!--
  Lock Screen 08 — same design as the approved Figma screen:
  navy background, big lock title, due / remaining amount,
  shop contact, offline code entry.
  Wave 3: overdue amount (not total), time context, check-again,
  emergency call, call-to-shop.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="🔒"
            android:textSize="64sp" />

        <TextView
            android:id="@+id/tvLockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/locked_title"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLockReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/locked_reason"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <!-- F-21: overdue installment amount (big), total remaining small. -->
        <TextView
            android:id="@+id/tvLockDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#1E2A4A"
            android:padding="16dp"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <!-- F-24: "locked since" + "next check". -->
        <TextView
            android:id="@+id/tvLockTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/white"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/locked_pay"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvShopContact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Al Arab Electronic"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- F-28: check again after paying. -->
        <Button
            android:id="@+id/btnCheckAgain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/emerald"
            android:text="@string/check_now_button" />

        <TextView
            android:id="@+id/tvCheckStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/lock_check_hint"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <!-- F-22: emergency call + call to shop. -->
        <Button
            android:id="@+id/btnEmergency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/red"
            android:text="@string/emergency_button" />

        <Button
            android:id="@+id/btnCallShop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#1E2A4A"
            android:text="@string/call_shop_button" />

        <EditText
            android:id="@+id/etOfflineCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@color/white"
            android:hint="@string/offline_code_hint"
            android:inputType="textCapCharacters"
            android:maxLength="6"
            android:padding="14dp" />

        <TextView
            android:id="@+id/tvOfflineHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/white"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnOfflineUnlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/emerald"
            android:text="@string/offline_unlock_button" />

        <TextView
            android:id="@+id/tvOfflineError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FCA5A5"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
