<?xml version="1.0" encoding="utf-8"?>
<!--
  AMG Customer Lock — Phase 3 (Device Owner / Device Policy Controller)
  Package: pk.amgsystems.lock

  IMPORTANT: This app only becomes a real lock AFTER Device Owner
  provisioning (QR code on a factory-reset phone — see QR-PROVISIONING.md).
  Installed as a normal app it CANNOT lock the phone, cannot block
  uninstall, and cannot block factory reset. That is an Android rule,
  not a bug in this app.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- J1-p09: FOREGROUND_SERVICE rehta hai (expedited check-in work —
         J1-m73 — ko Android 10-12 par foreground service chahiye hoti
         hai). FOREGROUND_SERVICE_DATA_SYNC aur REQUEST_INSTALL_PACKAGES
         hata diye gaye (istemal nahi hote). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Warning + completion notifications (Android 13+ runtime permission, maangi MainActivity mein jati hai). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Battery optimisation exemption (Doze defence, F-33 / A-M10). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Lock screen se dialer kholne ke liye (emergency / shop call, F-22):
         Android 11+ par resolveActivity ke liye queries chahiye. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:name=".LockApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AmgLock"
        tools:targetApi="34">

        <!-- Device Admin receiver — required for Device Owner provisioning. -->
        <receiver
            android:name=".AmgDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- Setup / status screen. Launcher icon. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- J2-m33: CATEGORY_HOME hata diya — ye app launcher nahi hai. -->
            </intent-filter>
        </activity>

        <!--
          Lock screen. Shown full-screen on top of everything when locked.
          android:excludeFromRecents + noHistory so the customer cannot
          swipe it away from Recents. Lock task mode is started by
          LockManager when Device Owner is active.
        -->
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- Warning screen (F-19): qist late, grace chal raha hai. -->
        <activity
            android:name=".WarningActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- Completion screen (F-32): aakhri qist ke baad. -->
        <activity
            android:name=".CompletionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- FCM push (Wave 5.4): server "check-in karo" ka ishara bhejta
             hai taake payment ke baad phone foran khule. Bina
             google-services.json ke Firebase init nahi hota aur ye
             service kabhi call nahi hoti. -->
        <service
            android:name=".AmgFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Re-apply the lock state after every reboot. J2-p18: receiver
             directBootAware hai — phone khule (PIN se pehle) hi lock
             dobara lag sake. Locked boot par sirf BootState (device-
             protected storage) parhte hain; encrypted prefs wahan
             dastiyab nahi hote. -->
        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
